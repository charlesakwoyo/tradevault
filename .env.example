#---------------------------------------------------------------------------
# TradeVault — environment template
# Copy to .env and fill in. NEVER commit real credentials.
#---------------------------------------------------------------------------

APP_NAME=TradeVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Comma-separated proxy IPs/CIDRs (load balancer), or * behind a trusted LB.
TRUSTED_PROXIES=

#--- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tradevault
DB_USERNAME=tradevault
DB_PASSWORD=

#--- Session / cache / queue -----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use redis in production.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=tradevault_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--- Platform & compliance (config/tradevault.php) --------------------------
# Keep true until a licensed market-data/execution provider is connected.
PLATFORM_BASE_CURRENCY=USD
PLATFORM_CURRENCIES=USD,KES
REGISTRATION_ENABLED=true
REGISTRATION_MINIMUM_AGE=18
# ISO 3166-1 alpha-2, comma separated. Empty allowed list = all not blocked.
GEO_ALLOWED_COUNTRIES=
GEO_BLOCKED_COUNTRIES=
KYC_REQUIRED_FOR_WITHDRAWAL=true
KYC_REQUIRED_FOR_TRADING=false
KYC_DOCUMENTS_DISK=kyc
KYC_MAX_UPLOAD_KB=8192
LIMIT_DEPOSIT_MIN=10
LIMIT_DEPOSIT_MAX=50000
LIMIT_WITHDRAWAL_MIN=10
LIMIT_WITHDRAWAL_MAX=50000
LIMIT_WITHDRAWAL_DAILY_MAX=100000
LEGAL_TERMS_VERSION=2026-09-01
SUPPORT_EMAIL=support@example.com

#--- Security ---------------------------------------------------------------
# Require staff to enable 2FA before accessing /admin (defaults on in production).
SECURITY_REQUIRE_STAFF_2FA=false
# API token lifetime in minutes (default 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
# Note: 2FA (TOTP) secrets are encrypted at rest with APP_KEY by Fortify, so
# no separate "2FA_SECRET" is needed (and env names cannot start with a digit).

#--- SMS (phone verification) ----------------------------------------------
# "log" is for development only and refuses to run in production.
SMS_DRIVER=log

#--- M-Pesa (Safaricom Daraja) ---------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/api/webhooks/mpesa"
# Shared secret appended to the callback URL, verified on receipt.
MPESA_CALLBACK_SECRET=

#--- Card / other payment provider ------------------------------------------
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

#--- Market data & execution ------------------------------------------------
MARKET_DATA_DRIVER=sandbox
MARKET_DATA_API_KEY=
MARKET_DATA_STALE_AFTER_SECONDS=300
# sandbox | binance. Use https://data-api.binance.vision where api.binance.com is geo-blocked.
BINANCE_BASE_URL=https://api.binance.com
TRADING_DRIVER=sandbox
TRADING_API_KEY=
TRADING_API_SECRET=
TRADING_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Sign in with Google: create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# In-app AI assistant (Claude). Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
